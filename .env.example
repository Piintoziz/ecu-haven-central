# Copia para .env e preenche. NUNCA comitar o .env (já está no .gitignore).

# --- Público (vai para o bundle do browser) ---
VITE_SUPABASE_URL=https://xxxfzxoubomyociufkou.supabase.co
# Chave publicável (pode ser exposta; o acesso é controlado por RLS)
VITE_SUPABASE_ANON_KEY=sb_publishable_EN56_R8elaJULsj25_j0mA_RCibPwdU
# Domínio de produção, sem barra final (usado em canonical, Open Graph e sitemap)
VITE_SITE_URL=https://www.o-teu-dominio.pt
# Opcional: Cloudflare Turnstile (proteção anti-bot nos formulários)
VITE_TURNSTILE_SITE_KEY=

# --- Só servidor (NUNCA com prefixo VITE_) ---
# Supabase > Project Settings > API > service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: segredo do Turnstile. Se vazio, a verificação é ignorada.
TURNSTILE_SECRET_KEY=
# Sal para anonimizar IPs (rate limiting). Gera um valor aleatório longo.
IP_HASH_SALT=

# --- Emails transacionais (só servidor) ---
# Resend (https://resend.com): domínio verificado + chave de API.
RESEND_API_KEY=
# Remetente, ex.: "Centralinas <encomendas@o-teu-dominio.pt>"
EMAIL_FROM=
# Opcional: endereço para onde vão as respostas dos clientes
EMAIL_REPLY_TO=
# Segredo do agendador que chama POST /api/emails/process (mín. 32 caracteres aleatórios)
CRON_SECRET=
